# Copy this file to .env and fill in your own keys. Never commit .env.

# EPA CAMPD API key, free from https://api.data.gov/signup/
# Used by scripts/fetch_campd_hourly.py and the live API pull on the upload page.
EPA_API_KEY=

# Google Gemini key, only needed for the optional natural-language search feature.
GEMINI_API_KEY=

# Optional: use a different database file (default: instance/epa_data.db)
# EPA_DATABASE_URI=sqlite:///C:/path/to/epa_data.db
